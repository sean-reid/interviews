# Rendered to /etc/caddy/Caddyfile by provision.sh. Caddy terminates
# TLS for the sslip.io hostname; the secret path tokens are the only
# routes to the two ttyd endpoints and the app. The upstream ports are
# fixed here and must match CandidatePort, ObserverPort, and AppPort in
# internal/session.
${HOSTNAME_FQDN} {
	handle_path /c/${IV_CANDIDATE_TOKEN}* {
		reverse_proxy 127.0.0.1:8001
	}

	handle_path /o/${IV_OBSERVER_TOKEN}* {
		reverse_proxy 127.0.0.1:8002
	}

	# The app is down for much of an interview by design, so this route 502s
	# and that is not a fault. /healthz below must never depend on it: start
	# polls /healthz to see the host come up, and the app being broken is
	# the interview working.
	handle_path /a/${IV_APP_TOKEN}* {
		reverse_proxy 127.0.0.1:8003
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond 404
	}
}
