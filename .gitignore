/interviews
.terraform/

# Written by the take-home harnesses when they run in place, and by the
# reaper's unit tests.
__pycache__/

# The zip terraform builds from the reaper source. The source is tracked; the
# artifact is rebuilt on every plan.
.reaper.zip

# Credentials, and the files that carry them by accident.
.env
.env.*

# Terraform state records the generated candidate, observer, and app tokens in
# plaintext, so it is a live session credential. A tfvars file is where a bucket
# name or a secret would sit. The provider lock files are deliberately not here:
# they pin hashes and belong in the repository.
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
